# ── Credentials ──────────────────────────────────────────────────────────────
# A Bing Webmaster Tools API key. To create one:
#   1. Sign in at https://www.bing.com/webmasters (Microsoft, Google or Facebook account).
#   2. Add and verify your site. Bing can import sites, already verified, from
#      Google Search Console: Add site → Import from GSC.
#   3. Settings (the gear, top right) → API Access → accept the terms →
#      API Key → Generate.
#
# There is ONE key per user, and it reaches every site that user has verified:
# every tool takes the site as an argument, and bing_webmaster_auth_status lists
# the sites this key reaches. Deleting or regenerating the key breaks every app
# that uses it — reuse the existing key rather than making a new one.
#
# The key travels in the request URL (?apikey=…). This server never logs or
# returns a URL, and masks the key in any upstream text that echoes it.
BING_WEBMASTER_API_KEY=

# ── Safety ───────────────────────────────────────────────────────────────────
# Set to 1 to register the WRITE tools: bing_webmaster_submit_urls (spends the
# site's daily URL submission quota), bing_webmaster_submit_sitemap,
# bing_webmaster_remove_sitemap (also requires confirm: true) and
# bing_webmaster_fetch_url. It also lets bing_webmaster_request call non-Get
# methods, each with confirm: true. Off by default: the write tools are then
# never registered, so an agent cannot call them at all.
BING_WEBMASTER_ALLOW_WRITES=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Override the API base URL (a proxy). Must be https://, since the key is in
# the URL; http:// is accepted only on loopback. An unusable value falls back
# to the default with a warning in bing_webmaster_auth_status.
# Default: https://ssl.bing.com/webmaster/api.svc/json
BING_WEBMASTER_API_URL=

# Retry budget for a GET on throttling (ThrottleUser / ThrottleHost / 429),
# 5xx, timeouts and network errors. 0-10, defaults to 3. POSTs (submissions)
# are never retried automatically: a retry could submit twice. Every call,
# retries included, ends within 45 s; a Retry-After over 30 s fails at once.
# An out-of-range value is clamped and reported by bing_webmaster_auth_status.
BING_WEBMASTER_MAX_RETRIES=

# Per-attempt timeout in ms, 1000-300000. Defaults to 30000.
BING_WEBMASTER_TIMEOUT_MS=

# Set to 1 to log debug output (method names only, never URLs) to stderr.
BING_WEBMASTER_DEBUG=
